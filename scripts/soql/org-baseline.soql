-- Baseline da org — usar para detectar resíduo após qualquer operação de metadado.
-- Comparar com MEMORY.md §1.6.
-- Baseline em 2026-10-16: total 253 · ativos 216 · locais 29

SELECT COUNT() FROM FlowDefinitionView
SELECT COUNT() FROM FlowDefinitionView WHERE IsActive = true
SELECT COUNT() FROM FlowDefinitionView WHERE NamespacePrefix = null

-- Resíduo de metadado do projeto (deve ser 0 fora de uma sessão de trabalho)
SELECT ApiName, Label, ProcessType, IsActive, VersionNumber
FROM FlowDefinitionView WHERE ApiName LIKE 'DD_%'

