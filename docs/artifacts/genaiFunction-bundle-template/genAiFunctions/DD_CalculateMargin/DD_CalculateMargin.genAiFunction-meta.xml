<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template de ACAO de agente Agentforce (GenAiFunction) apontando para um Flow.
  Validado no teste T7 (deploy + retrieve OK), API 66.0.

  Regras:
    - invocationTargetType = "flow"  (o valor da referencia padrao e "standardInvocableAction" - nao confundir)
    - invocationTarget = API name do AutoLaunchedFlow, que precisa estar ACTIVE
    - developerName / localDeveloperName = API name da acao (casa com o nome da pasta)
    - O Flow alvo DEVE declarar variaveis isInput/isOutput (ver agentforce-action-flow-reference)
    - Os dois schema.json precisam existir, senao a org recusa o retrieve (A43)
-->
<GenAiFunction xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Calcula a margem de uma cotacao, identifica a politica de desconto aplicavel e devolve a decisao do guardrail (AutoApproved, ManagerApproval ou Blocked). Nunca aprova.</description>
    <developerName>DD_CalculateMargin</developerName>
    <invocationTarget>DD_CalculateQuoteMargin</invocationTarget>
    <invocationTargetType>flow</invocationTargetType>
    <isConfirmationRequired>false</isConfirmationRequired>
    <localDeveloperName>DD_CalculateMargin</localDeveloperName>
    <masterLabel>DD Calculate Margin</masterLabel>
</GenAiFunction>
