<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <decisions>
        <name>Check_Approved</name>
        <label>Existe pedido aprovado?</label>
        <locationX>352</locationX>
        <locationY>200</locationY>
        <defaultConnector>
            <targetReference>Set_Gate_False</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Nao</defaultConnectorLabel>
        <rules>
            <name>Sim</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_ApprovedRequest.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Gate_True</targetReference>
            </connector>
            <label>Sim</label>
        </rules>
    </decisions>
    <description>Mantem Quote.DD_HasApprovedRequest__c (F7-01/D34). Dispara ao criar ou alterar o pedido de desconto, consulta se a cotacao tem algum pedido com Status Approved e grava o gate na cotacao. O gate existe porque ValidationRule nao consulta registros filhos. Falha na gravacao do gate derruba a transacao de proposito: gate silenciosamente velho liberaria aceitar sem aprovacao.</description>
    <label>DD Sincroniza o Gate de Aprovacao da Cotacao</label>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_ApprovedRequest</name>
        <label>Busca pedido aprovado da cotacao</label>
        <locationX>176</locationX>
        <locationY>200</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Approved</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Quote__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Quote__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>DD_DiscountRequest__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Set_Gate_False</name>
        <label>Zera o gate da cotacao</label>
        <locationX>528</locationX>
        <locationY>280</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Quote__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>DD_HasApprovedRequest__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <object>Quote</object>
    </recordUpdates>
    <recordUpdates>
        <name>Set_Gate_True</name>
        <label>Marca o gate da cotacao</label>
        <locationX>528</locationX>
        <locationY>120</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Quote__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>DD_HasApprovedRequest__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>Quote</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_ApprovedRequest</targetReference>
        </connector>
        <filterFormula>ISNEW() || ISCHANGED({!$Record.Status__c}) || ISCHANGED({!$Record.Quote__c})</filterFormula>
        <object>DD_DiscountRequest__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
