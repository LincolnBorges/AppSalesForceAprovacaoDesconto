    <description>Calcula a margem da cotacao com desconto simulado, resolve a politica de desconto em cascata de especificidade e devolve a faixa do guardrail. Invocavel por agente e por LWC.</description>
    <formulas>
        <name>F_EffectiveRevenue</name>
        <dataType>Currency</dataType>
        <expression>{!quote.DD_Revenue__c} * {!factor}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>F_Factor</name>
        <dataType>Number</dataType>
        <expression>1 - ({!requestedDiscountPct} / 100)</expression>
        <scale>6</scale>
    </formulas>
    <formulas>
        <name>F_EffectiveMargin</name>
        <dataType>Number</dataType>
        <expression>(({!effectiveRevenue} - {!quote.DD_Cost__c}) / {!effectiveRevenue}) * 100</expression>
        <scale>4</scale>
    </formulas>
    <formulas>
        <name>F_WorstAdjusted</name>
        <dataType>Number</dataType>
        <expression>100 - ((100 - ({!quote.DD_WorstLineMarginPct__c} * 100)) / {!factor})</expression>
        <scale>4</scale>
    </formulas>
    <formulas>
        <name>F_FloorPct</name>
        <dataType>Number</dataType>
        <expression>{!appliedPolicy.FloorMarginPct__c} * 100</expression>
        <scale>4</scale>
    </formulas>
    <formulas>
        <name>F_TargetPct</name>
        <dataType>Number</dataType>
        <expression>{!appliedPolicy.TargetMarginPct__c} * 100</expression>
        <scale>4</scale>
    </formulas>
    <formulas>
        <name>F_MaxDiscountPct</name>
        <dataType>Number</dataType>
        <expression>{!appliedPolicy.MaxDiscountPct__c} * 100</expression>
        <scale>4</scale>
    </formulas>
    <formulas>
        <name>F_Expl_NoPolicy</name>
        <dataType>String</dataType>
        <expression>"Cotação " &amp; {!quoteName} &amp; " (família " &amp; {!productFamily} &amp; "): não existe política de desconto ativa para esta família e price book. Nenhum piso de margem foi aplicado; a decisão fica pendente de política."</expression>
    </formulas>
    <formulas>
        <name>F_Expl_Green</name>
        <dataType>String</dataType>
        <expression>"Cotação " &amp; {!quoteName} &amp; " aprovada automaticamente: a margem efetiva atende ao alvo da política " &amp; {!policyName} &amp; " (piso " &amp; TEXT(ROUND({!floorMarginPct}, 2)) &amp; "%, alvo " &amp; TEXT(ROUND({!targetMarginPct}, 2)) &amp; "%). Estado: Saudável."</expression>
    </formulas>
    <formulas>
        <name>F_Expl_Yellow</name>
        <dataType>String</dataType>
        <expression>"Cotação " &amp; {!quoteName} &amp; " exige justificativa: a margem efetiva ficou abaixo do alvo da política " &amp; {!policyName} &amp; " (piso " &amp; TEXT(ROUND({!floorMarginPct}, 2)) &amp; "%, alvo " &amp; TEXT(ROUND({!targetMarginPct}, 2)) &amp; "%), mas ainda acima do piso. Estado: Requer Justificativa."</expression>
    </formulas>
    <formulas>
        <name>F_Expl_Red</name>
        <dataType>String</dataType>
        <expression>"Cotação " &amp; {!quoteName} &amp; " exige aprovação: a margem efetiva ficou abaixo do piso da política " &amp; {!policyName} &amp; " (piso " &amp; TEXT(ROUND({!floorMarginPct}, 2)) &amp; "%, alvo " &amp; TEXT(ROUND({!targetMarginPct}, 2)) &amp; "%). Estado: Requer Aprovação."</expression>
    </formulas>
    <formulas>
        <name>F_Diagnostics</name>
        <dataType>String</dataType>
        <expression>"margin=" &amp; TEXT(ROUND({!marginPct}, 4)) &amp; " | worst=" &amp; TEXT(ROUND({!worstLineMarginPct}, 4)) &amp; " | floor=" &amp; TEXT(ROUND({!floorMarginPct}, 4)) &amp; " | target=" &amp; TEXT(ROUND({!targetMarginPct}, 4)) &amp; " | spec=" &amp; TEXT(ROUND({!specificity}, 0)) &amp; " | factor=" &amp; TEXT(ROUND({!factor}, 4))</expression>
    </formulas>
