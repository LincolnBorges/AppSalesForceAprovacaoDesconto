    <formulas>
        <name>F_Factor</name>
        <dataType>Number</dataType>
        <expression>IF({!requestedDiscountPct} &gt; 0, 100 - {!requestedDiscountPct}, 100)</expression>
    </formulas>
    <formulas>
        <name>F_EffRevenue</name>
        <dataType>Currency</dataType>
        <expression>{!quote.DD_Revenue__c} * {!netPct} / 100</expression>
    </formulas>
    <formulas>
        <name>F_EffMargin</name>
        <dataType>Number</dataType>
        <expression>IF({!effRevenue} = 0, 0, ({!effRevenue} - {!quote.DD_Cost__c}) * 100 / {!effRevenue})</expression>
    </formulas>
    <formulas>
        <name>F_WorstPct</name>
        <dataType>Number</dataType>
        <expression>IF({!quote.DD_WorstLineMarginPct__c} &gt; 1, {!quote.DD_WorstLineMarginPct__c}, {!quote.DD_WorstLineMarginPct__c} * 100)</expression>
    </formulas>
    <formulas>
        <name>F_Norm</name>
        <dataType>Number</dataType>
        <expression>IF({!F_FloorRaw} &gt; 1, 1, 100)</expression>
    </formulas>
    <formulas>
        <name>F_FloorPct</name>
        <dataType>Number</dataType>
        <expression>{!F_FloorRaw} * {!F_Norm}</expression>
    </formulas>
    <formulas>
        <name>F_TargetPct</name>
        <dataType>Number</dataType>
        <expression>{!F_TargetRaw} * {!F_Norm}</expression>
    </formulas>
    <formulas>
        <name>F_MaxPct</name>
        <dataType>Number</dataType>
        <expression>{!F_MaxRaw} * {!F_Norm}</expression>
    </formulas>
    <formulas>
        <name>F_Expl_Green</name>
        <dataType>String</dataType>
        <expression>"Cotacao " &amp; {!quoteName} &amp; ": margem dentro do alvo da politica " &amp; {!policyName} &amp; " (piso " &amp; TEXT(ROUND({!floorMarginPct}, 2)) &amp; "%, alvo " &amp; TEXT(ROUND({!targetMarginPct}, 2)) &amp; "%). Estado: Saudavel, aprovada automaticamente pela regra."</expression>
    </formulas>
    <formulas>
        <name>F_Expl_Yellow</name>
        <dataType>String</dataType>
        <expression>"Cotacao " &amp; {!quoteName} &amp; ": margem abaixo do alvo e acima do piso da politica " &amp; {!policyName} &amp; " (piso " &amp; TEXT(ROUND({!floorMarginPct}, 2)) &amp; "%, alvo " &amp; TEXT(ROUND({!targetMarginPct}, 2)) &amp; "%). Estado: Requer Justificativa."</expression>
    </formulas>
    <formulas>
        <name>F_Expl_Red</name>
        <dataType>String</dataType>
        <expression>"Cotacao " &amp; {!quoteName} &amp; ": margem abaixo do piso da politica " &amp; {!policyName} &amp; " (piso " &amp; TEXT(ROUND({!floorMarginPct}, 2)) &amp; "%, alvo " &amp; TEXT(ROUND({!targetMarginPct}, 2)) &amp; "%). Estado: Requer Aprovacao."</expression>
    </formulas>
    <formulas>
        <name>F_Expl_NoPolicy</name>
        <dataType>String</dataType>
        <expression>"Cotacao " &amp; {!quoteName} &amp; " (familia " &amp; {!productFamily} &amp; "): nao existe politica de desconto ativa para esta familia e price book. Nenhum piso foi aplicado; a decisao fica pendente de politica."</expression>
    </formulas>
    <formulas>
        <name>F_Expl_Block</name>
        <dataType>String</dataType>
        <expression>"Nao foi possivel avaliar a cotacao " &amp; {!quoteId} &amp; ": cotacao inexistente ou sem linhas. Nenhuma decisao foi tomada."</expression>
    </formulas>
    <formulas>
        <name>F_CostPending</name>
        <dataType>Boolean</dataType>
        <expression>{!quote.DD_Cost__c} &lt;= 0</expression>
    </formulas>
    <formulas>
        <name>F_Expl_CostPending</name>
        <dataType>String</dataType>
        <expression>"Cotacao " &amp; {!quoteName} &amp; ": o custo das linhas nao esta cadastrado no price book (custo total zero ou nulo). Estado: Pendente de Custo. O Pricing precisa cadastrar o custo antes de avaliar o desconto; nenhuma margem foi considerada e o pedido nao deve ser liberado."</expression>
    </formulas>
    <formulas>
        <name>F_Diag</name>
        <dataType>String</dataType>
        <expression>"netPct=" &amp; TEXT({!netPct}) &amp; " | dIn=" &amp; TEXT(ROUND({!requestedDiscountPct}, 2)) &amp; " | marginBp=" &amp; TEXT({!F_Bp}) &amp; " | worstBpAdj=" &amp; TEXT({!F_WorstBpAdj}) &amp; " | worstBp=" &amp; TEXT({!F_WorstBp}) &amp; " | floorBp=" &amp; TEXT({!F_FloorBp}) &amp; " | targetBp=" &amp; TEXT({!F_TargetBp}) &amp; " | floorRaw=" &amp; TEXT({!F_FloorRaw}) &amp; " | rev=" &amp; TEXT(ROUND({!effRevenue}, 2)) &amp; " | cost=" &amp; TEXT(ROUND({!quote.DD_Cost__c}, 2)) &amp; " | spec=" &amp; TEXT(ROUND({!specificity}, 0)) &amp; " | costPending=" &amp; IF({!F_CostPending}, "1", "0")</expression>
    </formulas>
    <formulas>
        <name>F_FloorRaw</name>
        <dataType>Number</dataType>
        <expression>IF(NOT(ISBLANK({!policyL3.FloorMarginPct__c})), {!policyL3.FloorMarginPct__c}, IF(NOT(ISBLANK({!policyL2.FloorMarginPct__c})), {!policyL2.FloorMarginPct__c}, IF(NOT(ISBLANK({!policyL1.FloorMarginPct__c})), {!policyL1.FloorMarginPct__c}, {!policyL0.FloorMarginPct__c})))</expression>
    </formulas>
    <formulas>
        <name>F_TargetRaw</name>
        <dataType>Number</dataType>
        <expression>IF(NOT(ISBLANK({!policyL3.TargetMarginPct__c})), {!policyL3.TargetMarginPct__c}, IF(NOT(ISBLANK({!policyL2.TargetMarginPct__c})), {!policyL2.TargetMarginPct__c}, IF(NOT(ISBLANK({!policyL1.TargetMarginPct__c})), {!policyL1.TargetMarginPct__c}, {!policyL0.TargetMarginPct__c})))</expression>
    </formulas>
    <formulas>
        <name>F_MaxRaw</name>
        <dataType>Number</dataType>
        <expression>IF(NOT(ISBLANK({!policyL3.MaxDiscountPct__c})), {!policyL3.MaxDiscountPct__c}, IF(NOT(ISBLANK({!policyL2.MaxDiscountPct__c})), {!policyL2.MaxDiscountPct__c}, IF(NOT(ISBLANK({!policyL1.MaxDiscountPct__c})), {!policyL1.MaxDiscountPct__c}, {!policyL0.MaxDiscountPct__c})))</expression>
    </formulas>
    <formulas>
        <name>F_SpecRaw</name>
        <dataType>Number</dataType>
        <expression>IF(NOT(ISBLANK({!policyL3.Specificity__c})), {!policyL3.Specificity__c}, IF(NOT(ISBLANK({!policyL2.Specificity__c})), {!policyL2.Specificity__c}, IF(NOT(ISBLANK({!policyL1.Specificity__c})), {!policyL1.Specificity__c}, {!policyL0.Specificity__c})))</expression>
    </formulas>
    <formulas>
        <name>F_PolicyId</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!policyL3.Name})), {!policyL3.Id}, IF(NOT(ISBLANK({!policyL2.Name})), {!policyL2.Id}, IF(NOT(ISBLANK({!policyL1.Name})), {!policyL1.Id}, {!policyL0.Id})))</expression>
    </formulas>
    <formulas>
        <name>F_PolicyName</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!policyL3.Name})), {!policyL3.Name}, IF(NOT(ISBLANK({!policyL2.Name})), {!policyL2.Name}, IF(NOT(ISBLANK({!policyL1.Name})), {!policyL1.Name}, {!policyL0.Name})))</expression>
    </formulas>
    <formulas>
        <name>F_JustRaw</name>
        <dataType>Boolean</dataType>
        <expression>IF(NOT(ISBLANK({!policyL3.Name})), {!policyL3.RequiresJustification__c}, IF(NOT(ISBLANK({!policyL2.Name})), {!policyL2.RequiresJustification__c}, IF(NOT(ISBLANK({!policyL1.Name})), {!policyL1.RequiresJustification__c}, {!policyL0.RequiresJustification__c})))</expression>
    </formulas>
    <formulas>
        <name>F_Bp</name>
        <dataType>Number</dataType>
        <expression>ROUND(({!effRevenue} - {!quote.DD_Cost__c}) * 10000 / {!effRevenue}, 0)</expression>
    </formulas>
    <formulas>
        <name>F_WorstBp</name>
        <dataType>Number</dataType>
        <expression>ROUND(IF({!quote.DD_WorstLineMarginPct__c} &gt; 1, {!quote.DD_WorstLineMarginPct__c}, {!quote.DD_WorstLineMarginPct__c} * 100) * 100, 0)</expression>
    </formulas>
    <formulas>
        <name>F_FloorBp</name>
        <dataType>Number</dataType>
        <expression>ROUND({!F_FloorRaw} * 100, 0)</expression>
    </formulas>
    <formulas>
        <name>F_TargetBp</name>
        <dataType>Number</dataType>
        <expression>ROUND({!F_TargetRaw} * 100, 0)</expression>
    </formulas>
    <formulas>
        <name>F_WorstBpAdj</name>
        <dataType>Number</dataType>
        <expression>ROUND(10000 - ((10000 - {!F_WorstBp}) * 100 / {!netPct}), 0)</expression>
    </formulas>
