    <formulas>
        <name>F_HasJustification</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!justification}))</expression>
    </formulas>
    <formulas>
        <name>F_MsgCostPending</name>
        <dataType>String</dataType>
        <expression>"Cotacao " &amp; {!quoteName} &amp; ": o custo das linhas nao esta cadastrado no price book, entao o desconto nao pode ser avaliado. Estado: Pendente de Custo. Nenhum pedido foi criado. O Pricing precisa cadastrar o custo e a avaliacao deve ser repetida."</expression>
    </formulas>
    <formulas>
        <name>F_Subject</name>
        <dataType>String</dataType>
        <expression>"Pedido de desconto " &amp; {!quoteName} &amp; " aguarda sua aprovacao"</expression>
    </formulas>
    <formulas>
        <name>F_Body</name>
        <dataType>String</dataType>
        <expression>"Cotacao: " &amp; {!quoteName} &amp; " - desconto pedido " &amp; TEXT({!requestedDiscountPct}) &amp; "% - politica " &amp; {!policyName} &amp; " - estado " &amp; {!guardrailState}</expression>
    </formulas>
    <formulas>
        <name>F_MsgAuto</name>
        <dataType>String</dataType>
        <expression>"Cotacao " &amp; {!quoteName} &amp; " esta no alvo da politica " &amp; {!policyName} &amp; ". Nenhum pedido foi criado."</expression>
    </formulas>
    <formulas>
        <name>F_MsgNoPolicy</name>
        <dataType>String</dataType>
        <expression>"Cotacao " &amp; {!quoteName} &amp; " nao tem politica de desconto ativa. Nenhum pedido foi criado."</expression>
    </formulas>
    <formulas>
        <name>F_MsgJust</name>
        <dataType>String</dataType>
        <expression>"A politica " &amp; {!policyName} &amp; " exige justificativa. Informe o motivo antes de enviar."</expression>
    </formulas>
    <formulas>
        <name>F_MsgBlocked</name>
        <dataType>String</dataType>
        <expression>"Nao foi possivel resolver um aprovador para esta cotacao. Cadastre o gestor do dono ou verifique o dono da politica e os admins ativos."</expression>
    </formulas>
    <formulas>
        <name>F_MsgDone</name>
        <dataType>String</dataType>
        <expression>"Pedido " &amp; {!requestId} &amp; " enviado para " &amp; {!approverName} &amp; " (origem: " &amp; {!approverSource} &amp; ")."</expression>
    </formulas>
    <formulas>
        <name>F_MsgEmailFault</name>
        <dataType>String</dataType>
        <expression>"Pedido " &amp; {!requestId} &amp; " criado e pendente de notificacao: houve falha no envio do e-mail. Avise o aprovador " &amp; {!approverName} &amp; " manualmente."</expression>
    </formulas>
    <formulas>
        <name>F_HasManager</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!owner.ManagerId}))</expression>
    </formulas>
    <formulas>
        <name>F_HasOpenRequest</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!openRequest.Id}))</expression>
    </formulas>
    <formulas>
        <name>F_HasAdmin</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!admin.Id}))</expression>
    </formulas>
    <label>DD Route Discount Approval</label>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Request</name>
        <label>Cria o pedido de desconto</label>
        <locationX>100</locationX>
        <locationY>900</locationY>
        <assignRecordIdToReference>requestId</assignRecordIdToReference>
        <connector><targetReference>Send_Email</targetReference></connector>
        <faultConnector><targetReference>Fault_Handler</targetReference></faultConnector>
        <inputAssignments><field>Quote__c</field><value><elementReference>quoteId</elementReference></value></inputAssignments>
        <inputAssignments><field>Policy__c</field><value><elementReference>policyId</elementReference></value></inputAssignments>
        <inputAssignments><field>PolicyName__c</field><value><elementReference>policyName</elementReference></value></inputAssignments>
        <inputAssignments><field>PolicySpecificity__c</field><value><elementReference>specificity</elementReference></value></inputAssignments>
        <inputAssignments><field>PolicyFloorMarginPct__c</field><value><elementReference>floorMarginPct</elementReference></value></inputAssignments>
        <inputAssignments><field>PolicyTargetMarginPct__c</field><value><elementReference>targetMarginPct</elementReference></value></inputAssignments>
        <inputAssignments><field>PolicyMaxDiscountPct__c</field><value><elementReference>maxDiscountPct</elementReference></value></inputAssignments>
        <inputAssignments><field>PolicyRequiresJustification__c</field><value><elementReference>requiresJustification</elementReference></value></inputAssignments>
        <inputAssignments><field>GuardrailState__c</field><value><elementReference>guardrailState</elementReference></value></inputAssignments>
        <inputAssignments><field>Decision__c</field><value><stringValue>ManagerApproval</stringValue></value></inputAssignments>
        <inputAssignments><field>Status__c</field><value><stringValue>Submitted</stringValue></value></inputAssignments>
        <inputAssignments><field>RequestedDiscountPct__c</field><value><elementReference>requestedDiscountPct</elementReference></value></inputAssignments>
        <inputAssignments><field>Justification__c</field><value><elementReference>justification</elementReference></value></inputAssignments>
        <inputAssignments><field>Approver__c</field><value><elementReference>approverId</elementReference></value></inputAssignments>
        <inputAssignments><field>ApproverSource__c</field><value><elementReference>approverSource</elementReference></value></inputAssignments>
        <inputAssignments><field>CurrencyIsoCode</field><value><stringValue>USD</stringValue></value></inputAssignments>
        <object>DD_DiscountRequest__c</object>
    </recordCreates>
    <recordLookups>
