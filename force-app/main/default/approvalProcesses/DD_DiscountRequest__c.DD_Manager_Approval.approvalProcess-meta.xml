<?xml version="1.0" encoding="UTF-8"?>
<!-- F5-12: interface nativa de decisao humana. O guardrail de margem continua no Flow
     DD_RouteDiscountApproval; este Approval Process entrega ao gerente a tela
     "Itens para Aprovar", com comentario, historico e os botoes Aprovar/Rejeitar. -->
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <type>allInternalUsers</type>
    </allowedSubmitters>
    <!-- F5-14: a tela de aprovacao NAO usa o Page Layout do objeto; usa este approvalPageFields.
         Sem ele o aprovador ve apenas Numero do Pedido e Owner (default da plataforma). -->
    <approvalPageFields>
        <field>Name</field>
        <field>Quote__c</field>
        <field>RequestedDiscountPct__c</field>
        <field>OriginalAmount__c</field>
        <field>DiscountAmount__c</field>
        <field>FinalAmount__c</field>
        <field>GuardrailState__c</field>
        <field>PolicyName__c</field>
        <field>PolicyFloorMarginPct__c</field>
        <field>PolicyTargetMarginPct__c</field>
        <field>Justification__c</field>
        <field>Owner</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <name>Approver__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Gerente Comercial</label>
        <name>Gerente_Comercial</name>
    </approvalStep>
    <description>Aprovacao do pedido de desconto criado pelo guardrail. O aprovador vem resolvido do Flow (D26) no campo Approver__c; a aprovacao final grava Status__c e DecidedAt__c.</description>
    <enableMobileDeviceAccess>true</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>DD_DiscountRequest__c.Status__c</field>
            <operation>equals</operation>
            <value>Submitted</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>DD_Request_Status_Approved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>DD_Request_Decided_At</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>DD_Request_Status_Rejected</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>DD_Request_Decided_At</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <label>Approvação do Pedido de Desconto</label>
    <processOrder>1</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
