<?xml version="1.0" encoding="UTF-8"?>
<!-- F5-13 (2026-10-18): layout orientado a decisao do gerente. Ordem = o que ele precisa
     ver para aprovar sem abrir a cotacao: o que foi pedido, sob qual politica, com qual
     justificativa. Nenhum campo de margem ou custo da cotacao entra aqui (D14); os campos
     Policy* sao os limites DA POLITICA (snapshot), nao o resultado do negocio. -->
<Layout xmlns="http://soap.sforce.com/2006/04/metadata">
    <layoutSections>
        <customLabel>false</customLabel>
        <detailHeading>true</detailHeading>
        <editHeading>true</editHeading>
        <label>Resumo do Pedido</label>
        <layoutColumns>
            <layoutItems>
                <behavior>Required</behavior>
                <field>Quote__c</field>
            </layoutItems>
            <layoutItems>
                <behavior>Edit</behavior>
                <field>OriginalAmount__c</field>
            </layoutItems>
            <layoutItems>
                <behavior>Edit</behavior>
                <field>DiscountAmount__c</field>
            </layoutItems>
            <layoutItems>
                <behavior>Edit</behavior>
                <field>FinalAmount__c</field>
            </layoutItems>
        </layoutColumns>
        <layoutColumns>
            <layoutItems>
                <behavior>Edit</behavior>
                <field>RequestedDiscountPct__c</field>
            </layoutItems>
            <layoutItems>
                <behavior>Required</behavior>
                <field>GuardrailState__c</field>
            </layoutItems>
            <layoutItems>
                <behavior>Required</behavior>
                <field>Status__c</field>
            </layoutItems>
        </layoutColumns>
        <style>TwoColumnsTopToBottom</style>
    </layoutSections>
    <layoutSections>
        <customLabel>false</customLabel>
        <detailHeading>true</detailHeading>
        <editHeading>true</editHeading>
        <label>Política Aplicada</label>
        <layoutColumns>
            <layoutItems>
                <behavior>Edit</behavior>
                <field>PolicyName__c</field>
            </layoutItems>
            <layoutItems>
                <behavior>Edit</behavior>
                <field>PolicyFloorMarginPct__c</field>
            </layoutItems>
        </layoutColumns>
        <layoutColumns>
            <layoutItems>
                <behavior>Edit</behavior>
                <field>PolicyTargetMarginPct__c</field>
            </layoutItems>
        </layoutColumns>
        <style>TwoColumnsTopToBottom</style>
    </layoutSections>
    <layoutSections>
        <customLabel>false</customLabel>
        <detailHeading>true</detailHeading>
        <editHeading>true</editHeading>
        <label>Justificativa</label>
        <layoutColumns>
            <layoutItems>
                <behavior>Edit</behavior>
                <field>Justification__c</field>
            </layoutItems>
        </layoutColumns>
        <style>OneColumn</style>
    </layoutSections>
    <layoutSections>
        <customLabel>false</customLabel>
        <detailHeading>true</detailHeading>
        <editHeading>true</editHeading>
        <label>Decisão</label>
        <layoutColumns>
            <layoutItems>
                <behavior>Required</behavior>
                <field>Decision__c</field>
            </layoutItems>
            <layoutItems>
                <behavior>Edit</behavior>
                <field>DecisionNote__c</field>
            </layoutItems>
        </layoutColumns>
        <style>OneColumn</style>
    </layoutSections>
</Layout>
