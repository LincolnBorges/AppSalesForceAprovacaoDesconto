<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>DD_MarginPct__c</fullName>
    <description>Margem percentual consolidada da cotacao.</description>
    <externalId>false</externalId>
    <formula>IF(DD_Revenue__c = 0, 0, (DD_Revenue__c - DD_Cost__c) / DD_Revenue__c)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>DD Margem % da Cotacao</label>
    <precision>18</precision>
    <required>false</required>
    <scale>4</scale>
    <trackTrending>false</trackTrending>
    <type>Percent</type>
</CustomField>
