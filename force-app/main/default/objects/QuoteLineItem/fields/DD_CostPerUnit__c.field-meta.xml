<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>DD_CostPerUnit__c</fullName>
    <description>Custo por unidade lido do PricebookEntry por referencia cruzada. Diagnostico: nao pode ser somado por roll-up (A53).</description>
